# ===== Telegram User API =====
# Получить на https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=user_session

# ===== Веб-панель =====
WEB_HOST=127.0.0.1
WEB_PORT=8800
WEB_PASSWORD=changeme  # пароль на вход в панель

# ===== AI ключи (можно несколько, через запятую — для ротации) =====
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
CEREBRAS_API_KEYS=
SAMBANOVA_API_KEYS=
MISTRAL_API_KEYS=

# ===== Прокси для AI (опц.) =====
# Формат: socks5://user:pass@host:port  ИЛИ  http://user:pass@host:port
# Несколько через запятую
AI_PROXIES=

# ===== Прокси для Telegram (опц.) =====
# Формат: socks5://user:pass@host:port
TG_PROXY=

# ===== Лимиты =====
MIN_DELAY_SEC=180        # мин. задержка перед коммом после поста
MAX_DELAY_SEC=1800       # макс. задержка
MAX_COMMENTS_PER_HOUR=8  # глобальный rate-limit
COMMENT_PROBABILITY=0.7  # вероятность что бот вообще ответит на пост (0..1)

# ===== БД =====
DB_URL=sqlite+aiosqlite:///./app/data/neuro.db
